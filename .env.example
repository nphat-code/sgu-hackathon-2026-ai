# UrbanShield Lite - Edge AI Gateway Configuration
EDGE_API_KEY=urbanshield-sgu-2026-key

# Telegram Bot Dispatcher (Optional - falls back to local dispatcher if empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite Database Path
URBANSHIELD_DB_PATH=urbanshield_edge.db

# Configurable Video Stream FPS (Default: 28.5 FPS - optimal for office CPU playback)
# Examples: 15.0, 20.0, 24.0, 28.5, 30.0
STREAM_FPS=28.5

